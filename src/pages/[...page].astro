---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout>
    {page.currentPage === 1 && (
        <section class="card-base p-6 md:p-8 mb-4" aria-labelledby="profile-intro-title">
            <p class="text-[var(--primary)] font-medium mb-2">研究与实践</p>
            <h1 id="profile-intro-title" class="text-3xl font-bold text-90 mb-3">曾智尊 <span class="text-xl font-medium text-75">Zhizun Zeng</span></h1>
            <p class="text-75 text-base leading-relaxed">欢迎查阅我的个人博客</p>
            <div class="flex flex-wrap gap-3 mt-5">
                <a class="btn-regular rounded-lg px-4 py-2 font-medium" href={url('/about/')}>个人简历</a>
                <a class="btn-regular rounded-lg px-4 py-2 font-medium" href={url('/timeline/')}>经历时间线</a>

            </div>
        </section>
    )}
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
